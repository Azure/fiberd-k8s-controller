# The kind script reads these pins, so they stay in one place.
# It is sourced by bash, so keep it to plain NAME=value lines.
CERT_MANAGER_VERSION=v1.21.3
CERT_MANAGER_CSI_DRIVER_VERSION=v0.16.1
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# The fiberd a run tests when no input or variable names one. It takes main,
# a commit or a tag. Empty means the go.mod pin.
FIBERD_DEFAULT_REF=main
